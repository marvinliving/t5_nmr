# Template for a prediction config: a trained run's model and a dataset to
# run it on.
#
# To make one, copy this file to configs/predict/<name>.env, set RUN and
# EVAL_DATA_DIR, and delete the lines you leave at their defaults. Then:
# ./submit.sh predict <name>
#
# Settings not set here come from the run's config (configs/train/<run>.env),
# then from the environment at submission, then from the defaults below: a
# prediction scores the model as ./submit.sh evaluate <run> would. Settings
# whose default depends on the run are commented out.


# ===== Model and data =====

# Training config of the model to use, as in configs/train/<run>.env.
RUN=xxl_4x1x4_10ep
# Folder with src-test.txt and tgt-test.txt; train and val files aren't
# needed. The combined predictions are written here, named after the model:
# prd-test_<model>.txt, and the valid-SMILES scores prd-test_<model>_valid.json.
EVAL_DATA_DIR=/projects/b5an/nmr_expt_data
# The model folder. Default: the run's final_model, outputs/<run>/final_model.
# Set it for a checkpoint of a run without FSDP, outputs/<run>/checkpoint-<N>,
# or for a run trained with --nodes or --gpus, outputs/<run>_gb<N>/final_model.
# The model's name in the file names is then <run folder>_checkpoint-<N> or
# <run folder>. FSDP checkpoints can't be loaded this way.
#MODEL_PATH=outputs/<run>/final_model


# ===== Evaluation =====

# Candidate SMILES per spectrum: 1 is greedy decoding, more is beam search.
NUM_OUTPUTS=10
# test or validation (src-val.txt and tgt-val.txt).
EVAL_SPLIT=test
# Evaluate only the first rows of the split; 0 evaluates all of it.
EVAL_MAX_ROWS=0
# How the model writes SMILES: spaced, nospace, or auto to read it from the
# run's training targets. Where it differs from the dataset's, SMILES are
# compared without spaces.
SMILES_SPACING=auto
# Spectra per generate call, and the cap on rows x outputs x longest input
# tokens per batch.
EVAL_GENERATION_BATCH_SIZE=16
EVAL_MAX_BATCH_TOKENS=100000
# Longest SMILES generated.
GENERATION_MAX_NEW_TOKENS=640


# ===== Slurm resources =====

# Array tasks, one node each.
EVAL_CHUNKS=1
# GPUs per array task, each evaluating its own chunk, so the split is cut
# into EVAL_CHUNKS x EVAL_GPUS chunks. Above 1, a task takes the node's memory.
EVAL_GPUS=4
# Time limit of each chunk, and its host memory. Default memory: the whole
# node (0) with EVAL_GPUS above 1, otherwise 64G.
EVAL_TIME=10:00:00
#EVAL_MEM=64G
# 1 checks the combined predictions with RDKit once they are written
# (scripts/valid_smiles.py, a whole CPU node); 0 skips it.
PREDICT_VALID=1
VALID_TIME=02:00:00
