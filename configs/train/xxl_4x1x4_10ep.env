# xxl_4x1x4_10ep: FLAN-T5-xxl, 4 x 1 x 4 GPUs = 16 examples per update, 10 epochs.
# The same optimization as xxl_2x2x4_10ep, without gradient accumulation: each
# update runs one forward and backward pass instead of two, so FSDP gathers the
# weights half as often.
#
# From epoch 2.9 on it trains as 2 x 2 x 4, like xxl_2x2x4_10ep: at step 124,856
# a batch of 4 with an unusually long spectrum ran out of GPU memory in the
# backward pass (6.6 GB more needed, 7.6 GB free), and resuming would meet the
# same batch again. Global batch, learning rate and GPUs are unchanged, so the
# checkpoints still resume, and each update sees the same 16 examples.
MODEL_NAME=google/flan-t5-xxl
PER_GPU_BATCH=2
GRAD_ACCUMULATION_STEPS=2
NUM_EPOCHS=10
GRADIENT_CHECKPOINTING=1
PARALLEL_MODE=fsdp
GPUS_PER_NODE=4
# One checkpoint per epoch (about 42,500 updates). All 10 are kept, so
# ./submit.sh progress can score every epoch: the newest two whole (about
# 135 GB each), older ones without optimizer state (about 44 GB each),
# about 620 GB in all. Jobs still save before their time limit to resume
# from; those checkpoints are deleted once a newer one exists.
SAVE_STRATEGY=epoch
# The default, 4 x PER_GPU_BATCH = 16, ran out of GPU memory in validation:
# the attention of long spectra over XXL's 64 heads needed 17 GB at once.
EVAL_BATCH_SIZE=4
# Validation still ran out of memory at 4 with 11 GB of GPU memory reserved by
# PyTorch but unusable, split into pieces too small for its tensors.
# Expandable segments let PyTorch grow and reuse its memory without that
# fragmentation.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# The end-of-training generation test ran out of memory at the default 32:
# a batch with a 1,784-token spectrum needed 24 GB for one attention step.
GENERATION_BATCH_SIZE=8
