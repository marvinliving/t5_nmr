# Template for a run config, with every setting at its default value.
#
# To make a run, copy this file to configs/train/<run>.env, change what you
# need, and delete the lines you leave at their defaults so the config shows
# what makes the run different. Then: ./submit.sh train <run>
#
# Settings whose default depends on other settings are commented out: setting
# them to the value shown would stop them following those settings.


# ===== Model and data =====

# Hugging Face model: google/flan-t5-small, -base, -large, -xl or -xxl.
MODEL_NAME=google/flan-t5-base
# Folder with src-{train,val,test}.txt and tgt-{train,val,test}.txt; a
# relative path is relative to the repository root. Default: DATA_DIR in
# slurm/env.sh (/projects/b5an/alberts_2d on Isambard-AI).
#DATA_DIR=/projects/b5an/alberts_2d
# Text put in front of every spectrum.
PREFIX="predict SMILES from NMR spectrum: "
# SMILES longer than this many tokens are cut off in training.
TARGET_MAX_LENGTH=640
# Set to 1 on compute nodes without internet, after downloading the model once.
LOCAL_FILES_ONLY=0

# Where checkpoints and the final model go. Default: outputs/<run>.
# A smoke test (MAX_STEPS > 0) adds _max<N>steps to the folder name.
#OUTPUT_DIR=outputs/<run>
# Where the tokenized dataset is cached. Default: <OUTPUT_DIR>/tokenized.
#TOKENIZED_CACHE_DIR=outputs/<run>/tokenized


# ===== Optimisation =====
# The global batch is PER_GPU_BATCH x GRAD_ACCUMULATION_STEPS x GPUs. Keep it
# at 16 with LR_SCALING=none to compare with earlier runs.

# Examples per GPU per step. (Older configs call it TRAIN_BATCH_SIZE.)
PER_GPU_BATCH=16
# Steps combined into each model update.
GRAD_ACCUMULATION_STEPS=1
NUM_EPOCHS=3
# Stop after this many model updates, for smoke tests. 0 trains for NUM_EPOCHS.
MAX_STEPS=0
# Learning rate for a global batch of BASE_BATCH examples.
LEARNING_RATE=5e-5
BASE_BATCH=16
# How the learning rate follows a larger global batch: none (unchanged),
# sqrt (x sqrt(global / BASE_BATCH)) or linear (x global / BASE_BATCH).
LR_SCALING=none
# Share of training spent raising the learning rate from 0; 0.03 is 3%.
WARMUP_RATIO=0
WEIGHT_DECAY=0.01
SEED=42
# 1 saves GPU memory but trains about 30% slower.
GRADIENT_CHECKPOINTING=0
# 1 batches spectra of similar length together. Faster, but changes the order
# examples are drawn in, so results aren't directly comparable.
GROUP_BY_LENGTH=0


# ===== Validation and checkpoints =====

# Batch size for validation loss. Default: 4 x TRAIN_BATCH_SIZE.
#EVAL_BATCH_SIZE=64
# Validation molecules (the first ones) used for validation loss; 0 uses all.
EVAL_MAX_SAMPLES=5000
# Worker processes per GPU that prepare batches; also used for tokenizing.
# Default: 4 on 1 GPU, 8 on several.
#DATALOADER_NUM_WORKERS=4
# When to save a checkpoint: steps (every SAVE_STEPS updates) or epoch (at the
# end of every epoch). Either way a job also saves before its time limit, and
# only the newest SAVE_TOTAL_LIMIT checkpoints are kept.
SAVE_STRATEGY=steps
SAVE_STEPS=2000
SAVE_TOTAL_LIMIT=2
# Save and stop this many minutes before the job's time limit, then resubmit.
STOP_MARGIN_MINUTES=20


# ===== End-of-training quick test =====

# Test molecules generated after training (not the official score).
TEST_SAMPLE_SIZE=1000
GENERATION_BATCH_SIZE=32
# Longest SMILES generated, in the quick test and in the evaluation.
GENERATION_MAX_NEW_TOKENS=640


# ===== GPUs and Slurm resources for training =====

# ./submit.sh train <run> --nodes N --gpus N overrides these two.
NODES=1
GPUS_PER_NODE=1
# none on 1 GPU. On several: ddp (full model on every GPU), fsdp (model split
# across all GPUs, one node) or hsdp (split within each node, copied across
# nodes). Default: none on 1 GPU, ddp on more.
#PARALLEL_MODE=none
# Time limit of each training job.
TRAIN_TIME=1-00:00:00
# Host memory of each training job. Default: 64G on 1 GPU, the whole node (0)
# on several.
#TRAIN_MEM=64G
# How many times an unfinished run submits itself again.
MAX_RESUBMITS=20


# ===== Evaluation (./submit.sh evaluate <run>) =====

# Candidate SMILES per spectrum: 1 is greedy decoding, more is beam search.
NUM_OUTPUTS=10
# test or validation.
EVAL_SPLIT=test
# Spectra per generate call.
EVAL_GENERATION_BATCH_SIZE=16
# Array tasks, one node each.
EVAL_CHUNKS=1
# GPUs per array task, each evaluating its own chunk, so the split is cut
# into EVAL_CHUNKS x EVAL_GPUS chunks. Above 1, a task takes the node's memory.
EVAL_GPUS=4
# Evaluate only the first rows of the split; 0 evaluates all of it.
EVAL_MAX_ROWS=0
# Time limit and host memory of each chunk.
EVAL_TIME=10:00:00
EVAL_MEM=64G
